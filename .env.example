# PostgreSQL (docker compose exposes 5435 on loopback)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/heyintent_rack"

# Better Auth. BETTER_AUTH_URL is the single public origin (API + web UI).
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3001"
# Optional separate 32+ character key for per-MCP secrets (falls back to BETTER_AUTH_SECRET)
ENCRYPTION_KEY=""

# Sign-in accepts any valid email address.
# Emails that receive the admin role on first sign-in
ADMIN_EMAILS="yann@heyintent.com"

# SMTP (development always prints OTP codes to the api-rack console instead of sending email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Intent Ressource Rack <no-reply@heyintent.com>"

# OpenRouter (llm + image capabilities)
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="anthropic/claude-sonnet-4.5"
# Comma-separated allowlist (empty = any model)
OPENROUTER_ALLOWED_MODELS=""
OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image"

# GitHub (github capability). A token stored on an MCP takes precedence.
GITHUB_TOKEN=""

# MCP connection parameters: how the rack reaches each target system.
# Users never see these; they authenticate with the rack (OAuth or rk_ API key)
# and the rack calls the target system on their behalf. Unset = demo mode.
# Site public (heyintent.com)
SITE_PUBLIC_API_URL=""
SITE_PUBLIC_API_TOKEN=""
# Sample: dedicated GitHub token (overrides GITHUB_TOKEN for this MCP)
SAMPLE_GITHUB_TOKEN=""

# Apps hosted elsewhere that sign in through the rack (JSON array). Each one gets
# two OAuth resources, <url> (its UI) and <url>/mcp, and appears in the admin
# for group and user access; tokens carry the access level in `mcp_access`.
# EXTERNAL_MCPS='[{"slug":"veille-ao","name":"Veille AO","url":"https://veille-ao.vps02.heyintent.com"}]'
EXTERNAL_MCPS=""

# api-rack
PORT="3001"
HOST="127.0.0.1"
# Development: origin of the Vite UI, reached when an OAuth client lands on <BETTER_AUTH_URL>/login
WEB_DEV_ORIGIN="http://localhost:5173"
